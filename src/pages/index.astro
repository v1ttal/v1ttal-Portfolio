---
import BaseLayout from "../layouts/BaseLayout.astro"
import HorizontalCard from "../components/HorizontalCard.astro"
import TimeLineElement from "../components/cv/TimeLine.astro"
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello and thank you for visiting.</div>
    <div class="text-4xl font-bold">I'm VittalKumaar Murugan</div>
    <div class="text-xl py-3 font-bold">Data Science Graduate | Beyond Clean Code, Into Messy Real-World Data</div>
    <div class="py-2 w-full">
      <p class="text-lg text-justify">
        <p class="text-lg text-justify">
  Real data is rarely clean, and that's where I like to work. I'm a Data Science graduate who digs into messy,
  real-world datasets, finds what's slowing things down, and turns it into clear insights and working models.
  From data wrangling and visualisation to machine learning, I'm now open to opportunities as a Data Analyst,
  Data Scientist or ML Engineer.
</p>
      </p>
    </div>
    <div class="mt-8">
      <a
        class="btn"
        href="https://www.linkedin.com/in/vittal-kumaar/"
        target="_blank"
      >
      I'd appreciate connecting</a
      >
    </div>
  </div>

  <div class="time-line-container grid gap-4 mb-10 ml-5">
    <TimeLineElement
      title="Master's Degree"
      subtitle="MSc in Data Science and Statistical Learning (2025-2026) at University of Limerick, Limerick, Ireland."
    />
    <TimeLineElement
      title="Bachelor's Degree"
      subtitle="Bachelor of Technology (2020-2024) at Sethu Institute of Technology, Pulloor, Kariapatti, Madurai, Tamil Nadu, India."
    />
    <TimeLineElement
      title="School Education"
      subtitle="The TVS School, Madurai, Tamil Nadu, India (2006-2020)."
    />
  </div>

  <div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My latest projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="SpaceX IBM Data Science Final Capstone"
    img="/spacex.jpg"
    desc="A comprehensive data analysis and machine learning endeavor that incorporates multiple stages of data processing and visualization. This project includes data collection, wrangling, exploratory data analysis (EDA), and machine learning prediction to analyze and gain insights from SpaceX launch data."
    url="https://github.com/v1ttal/SpaceX_IBM_Data_Sciene_FInal_Capstone.git"
    badge="NEW"
    tags={["Python","Pandas","Matplotlib", "Seaborn","Folium","SQL","Machine Learning"]}
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Crop Yeild Prediction"
    img="/agri.jpg"
    desc="Its a web-based application designed to recommend suitable crops based on soil and weather conditions. The system aims to minimize human errors and provide accurate, real-time recommendations to assist farmers in selecting the best crops for their specific environment."
    url="https://github.com/v1ttal/crop_prediction_prediction.git"
    badge="NEW"
    tags={["Python", "Scikit-Learn", "Django", "Machine Learning","SQL"]}
  />
  <div class="divider my-0"></div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold mt-5">Technical Proficiency</div>
  </div>

  <div class="grid gap-5 mx-2 mb-5">
    <div>
      <h3 class="font-semibold mb-2">Programming & Querying</h3>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline badge-lg">Python</span>
        <span class="badge badge-outline badge-lg">SQL</span>
        <span class="badge badge-outline badge-lg">C / C++ / C#</span>
        <span class="badge badge-outline badge-lg">HTML, CSS & JavaScript</span>
      </div>
    </div>

    <div>
      <h3 class="font-semibold mb-2">Data Analysis & Visualisation</h3>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline badge-lg">Power BI</span>
        <span class="badge badge-outline badge-lg">Pandas</span>
        <span class="badge badge-outline badge-lg">NumPy</span>
        <span class="badge badge-outline badge-lg">Matplotlib</span>
        <span class="badge badge-outline badge-lg">Seaborn</span>
        <span class="badge badge-outline badge-lg">Data Cleaning & Wrangling</span>
        <span class="badge badge-outline badge-lg">Exploratory Data Analysis</span>
        <span class="badge badge-outline badge-lg">Dashboarding & Reporting</span>
      </div>
    </div>

    <div>
      <h3 class="font-semibold mb-2">Data Science & Machine Learning</h3>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline badge-lg">Scikit-Learn</span>
        <span class="badge badge-outline badge-lg">TensorFlow & Keras</span>
        <span class="badge badge-outline badge-lg">Statistical Learning</span>
        <span class="badge badge-outline badge-lg">Regression & Classification</span>
        <span class="badge badge-outline badge-lg">Predictive Modelling</span>
        <span class="badge badge-outline badge-lg">Deep Learning (CNNs)</span>
      </div>
    </div>

    <div>
      <h3 class="font-semibold mb-2">Tools & Others</h3>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline badge-lg">Git & GitHub</span>
        <span class="badge badge-outline badge-lg">Jupyter Notebook</span>
        <span class="badge badge-outline badge-lg">Astro</span>
        <span class="badge badge-outline badge-lg">Figma / UX Design</span>
      </div>
    </div>
  </div>

<div class="mt-10 mb-5">
    <div class="text-3xl w-full font-bold">Professional Certifications</div>
</div>

