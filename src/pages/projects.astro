---
import BaseLayout from "../layouts/BaseLayout.astro"
import HorizontalCard from "../components/HorizontalCard.astro"
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="SpaceX Launch Analysis: IBM Data Science Capstone"
    img="/spacex.jpg"
    desc="An end-to-end data science project analysing SpaceX launch data, covering data collection, wrangling, exploratory data analysis, interactive maps and machine learning to predict first-stage landing success."
    url="https://github.com/v1ttal/SpaceX_IBM_Data_Sciene_FInal_Capstone.git"
    tags={["Python", "Pandas", "Matplotlib", "Seaborn", "Folium", "SQL", "Machine Learning"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Crop Yield Prediction"
    img="/agri.jpg"
    desc="A web application that recommends suitable crops based on soil and weather conditions, reducing human error and giving farmers accurate, real-time recommendations for their environment."
    url="https://github.com/v1ttal/crop_prediction_prediction.git"
    tags={["Python", "Scikit-Learn", "Django", "Machine Learning", "SQL"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Residential Real Estate Price Prediction"
    img="/house.jpg"
    desc="A predictive model that estimates residential property prices from factors such as location, property size and proximity to amenities, built by analysing large datasets and applying machine learning algorithms."
    url="https://github.com/v1ttal/Residential_Real_Estate_Price.git"
    tags={["Python", "Scikit-Learn", "Data Analysis", "Machine Learning"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Automobile Sales Trends Dashboard"
    img="/automobile.png"
    desc="An analytical dashboard visualising automobile sales trends over time, letting users explore sales patterns across vehicle types, time periods and economic factors."
    url="https://github.com/v1ttal/Automobile_Sales_Trends_Dashboard.git"
    tags={["Python", "Pandas", "Matplotlib", "Seaborn"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="SIT Mind Map"
    img="/AR.jpg"
    desc="An Augmented Reality (AR) pathfinding prototype that guides users along virtual paths around the campus with real-time, interactive directions."
    url="https://github.com/v1ttal/SIT_Mind_Map.git"
    tags={["Unity C#", "Augmented Reality", "Computer Vision", "Android"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Flower Classification"
    img="/flower.png"
    desc="A deep learning model that classifies flower species using Convolutional Neural Networks (CNNs) built with TensorFlow and Keras."
    url="https://github.com/v1ttal/flowerclassification"
    tags={["Python", "TensorFlow", "Keras", "CNN"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Breast Cancer Prediction"
    img="/bst.jpg"
    desc="A predictive model for breast cancer diagnosis, comparing Logistic Regression, Decision Tree and Random Forest classifiers to achieve high accuracy."
    url="https://github.com/v1ttal/Brest_cancer.git"
    tags={["Python", "Scikit-Learn", "Logistic Regression", "Decision Tree", "Random Forest"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Travel Registration Page"
    img="/Travel.jpg"
    desc="A travel registration form for college students, built with HTML, CSS and PHP."
    url="https://github.com/v1ttal/Travel_login.git"
    tags={["HTML", "CSS", "PHP"]}
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Portfolio Website"
    img="/astro.jpeg"
    desc="This portfolio website, built with Astro and Tailwind CSS to showcase my work."
    url="https://github.com/v1ttal/v1ttal-Portfolio.git"
    tags={["Astro", "Tailwind CSS"]}
  />
</BaseLayout>